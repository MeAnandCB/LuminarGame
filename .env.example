# Copy to .env (never commit .env). Loaded by `npm start` / `npm run dev` if present.
PORT=3000
HOST=0.0.0.0
# SQLite database file (event state, scores, audit log). Back this file up.
DB_PATH=./data/brainbyte.db
# Optional: override the URL shown in the QR code (e.g. http://192.168.1.50:3000)
PUBLIC_URL=
# Admin session lifetime in hours
ADMIN_SESSION_HOURS=12
# Set to true ONLY when serving over HTTPS (adds the Secure cookie flag)
COOKIE_SECURE=false
# Max answer submissions per team per 10 seconds (anti-spam). Raise only for load tests.
RATE_LIMIT_ANSWER_MAX=12
